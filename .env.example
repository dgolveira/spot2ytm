# Copy to .env and adjust. Every setting is optional.

# Client ID of your Spotify developer app (can also be set from the web UI).
# SPOT2YTM_SPOTIFY_CLIENT_ID=

# Where tokens, YouTube Music headers and the database are stored.
# SPOT2YTM_DATA_DIR=data

# Interface and port to listen on.
# SPOT2YTM_HOST=127.0.0.1
# SPOT2YTM_PORT=8000

# URL your browser uses to open the app. The Spotify redirect URI is built from
# it, so it must match what you registered in the Spotify dashboard.
# SPOT2YTM_BASE_URL=http://127.0.0.1:8000

# Extra Host names to accept, comma separated (e.g. when behind a reverse proxy).
# SPOT2YTM_ALLOWED_HOSTS=

# Pause between YouTube Music searches, in seconds.
# SPOT2YTM_SEARCH_DELAY=0.2
